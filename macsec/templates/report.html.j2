<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>macsec-agents report - {{ generated_at }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, "SF Pro Text", Helvetica, Arial, sans-serif;
         max-width: 1080px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
  h1 { font-size: 1.6rem; } h2 { border-bottom: 1px solid #8884; padding-bottom: .3rem; }
  table { border-collapse: collapse; width: 100%; font-size: .85rem; margin: 1rem 0; }
  th, td { border: 1px solid #8884; padding: .4rem .6rem; text-align: left; vertical-align: top; }
  th { background: #8881; }
  .badge { display: inline-block; padding: .1rem .45rem; border-radius: .4rem;
           font-size: .75rem; font-weight: 600; }
  .P1-CRITICAL { background: #c00; color: #fff; }
  .P2-HIGH { background: #e60; color: #fff; }
  .P3-MEDIUM { background: #da3; color: #000; }
  .P4-LOW { background: #5a5; color: #fff; }
  .fail { color: #c00; font-weight: 700; } .pass { color: #2a2; font-weight: 700; }
  .exploited { background: #701; color: #fff; }
  .summary { background: #8881; border-radius: .6rem; padding: 1rem 1.2rem; }
  .muted { opacity: .65; font-size: .8rem; }
</style>
</head>
<body>
<h1>macsec-agents security report</h1>
<p class="muted">Generated {{ generated_at }} &middot;
{% if inventory %}{{ inventory.model }} ({{ inventory.chip }}) &middot; macOS {{ inventory.macos_product_version }} ({{ inventory.macos_build }}) &middot; {{ inventory.arch }}{% endif %}</p>

{% if stats.get("macsec_score") %}
<h2>MacSec Score</h2>
<div class="summary"><p style="font-size:2rem;margin:.2rem 0">
<strong>{{ stats.macsec_score.score }}/100</strong> &middot; Grade
<strong>{{ stats.macsec_score.grade }}</strong></p>
<ul>{% for b in stats.macsec_score.breakdown %}
<li>{{ b.category }}: &minus;{{ b.penalty }} <span class="muted">({{ b.detail }})</span></li>
{% endfor %}</ul></div>
{% endif %}

<h2>Executive summary</h2>
<div class="summary"><p>{{ llm_summary }}</p>
{% if llm_model %}<p class="muted">Analysis engine: {{ llm_model }}</p>{% endif %}</div>

<h2>Vulnerability findings ({{ risks | length }})</h2>
{% if risks %}
<table>
<tr><th>CVE</th><th>Tier</th><th>Score</th><th>Exploited</th><th>Affects</th><th>Component</th><th>Impact</th><th>Recommendation</th></tr>
{% for r in risks %}
<tr>
  <td><a href="{{ r.match.cve.advisory_url or '#' }}">{{ r.match.cve.cve_id }}</a></td>
  <td><span class="badge {{ r.tier }}">{{ r.tier }}</span></td>
  <td>{{ r.score }}</td>
  <td>{% if r.match.cve.exploited %}<span class="badge exploited">EXPLOITED</span>{% endif %}</td>
  <td>{{ r.match.target }} {{ r.match.target_version }}</td>
  <td>{{ r.match.cve.component }}</td>
  <td>{{ (r.match.cve.impact or r.match.cve.description)[:160] }}</td>
  <td>{{ r.recommendation }}</td>
</tr>
{% endfor %}
</table>
{% else %}<p>No CVE matches found.</p>{% endif %}

<h2>Hardening audit</h2>
<table>
<tr><th>ID</th><th>Control</th><th>Category</th><th>Severity</th><th>Status</th><th>Observed</th><th>Expected</th></tr>
{% for c in hardening %}
<tr>
  <td>{{ c.check_id }}</td><td>{{ c.title }}</td><td>{{ c.category }}</td>
  <td>{{ c.severity }}</td>
  <td class="{{ c.status }}">{{ c.status | upper }}</td>
  <td>{{ c.observed }}</td><td>{{ c.expected }}</td>
</tr>
{% endfor %}
</table>

<h3>Remediation</h3>
<ul>
{% for c in hardening if c.status == "fail" %}
<li><strong>{{ c.check_id }}</strong> {{ c.title }}: {{ c.remediation }}</li>
{% else %}
<li>All audited controls pass.</li>
{% endfor %}
</ul>

<h2>Feed provenance</h2>
<ul>
{% for f in feeds %}
<li><strong>{{ f.source }}</strong>: {{ f.records }} records, fetched {{ f.fetched_at }}
{% if f.errors %}<span class="fail">errors: {{ f.errors | join("; ") }}</span>{% endif %}</li>
{% endfor %}
</ul>
<p class="muted">Generated by macsec-agents. Apple CVE data via theevilbit/apple-cve-website
(parsed from support.apple.com), exploitation flags cross-checked with CISA KEV.</p>
</body>
</html>
